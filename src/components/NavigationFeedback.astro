<div class="navigation-feedback" data-navigation-feedback data-pagefind-ignore transition:persist="navigation-feedback" transition:name="navigation-feedback" transition:animate="none">
  <span class="navigation-progress" aria-hidden="true"></span>
  <span class="sr-only" data-navigation-status role="status" aria-live="polite" aria-atomic="true"></span>
  <div class="navigation-error" data-navigation-error hidden>
    <p data-route-message role="alert"></p>
    <button type="button" data-route-retry>重试</button>
  </div>
</div>
