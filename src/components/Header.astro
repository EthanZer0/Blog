---
import { siteConfig } from '../site.config';
import { withBase } from '../lib/content';
import { Logo } from './upstream/Logo';
import DesktopNav from './DesktopNav';
const pathname = Astro.url.pathname;
---
<!-- Shiro Header grid, sizing and ForDesktop capsule styles, without auth providers. -->
<header class="site-header fixed inset-x-0 top-0 z-[9] h-[4.5rem]" data-pagefind-ignore>
  <div class="header-grid relative mx-auto grid h-full max-w-7xl grid-cols-[4.5rem_auto_4.5rem] lg:px-8">
    <div class="header-logo center flex">
      <a href={withBase('/')} aria-label={`${siteConfig.title}首页`}><Logo aria-hidden="true" /></a>
    </div>
    <details class="mobile-menu lg:hidden">
      <summary aria-label="展开导航" class="center flex size-[4.5rem] cursor-pointer"><i class="i-mingcute-menu-line text-xl" aria-hidden="true"></i></summary>
      <nav aria-label="手机导航" class="mobile-menu-panel">
        {siteConfig.nav.map(item => <a href={withBase(item.path)}>{item.title}</a>)}
        <a href={withBase('/search/')}>搜索</a>
      </nav>
    </details>
    <div class="center hidden min-w-0 grow lg:flex">
      <DesktopNav pathname={pathname} client:load />
    </div>
    <div class="center flex"><a href={withBase('/search/')} aria-label="搜索文章" class="center flex size-10 rounded-full transition hover:bg-zinc-100 dark:hover:bg-zinc-800"><i class="i-mingcute-search-line text-xl" aria-hidden="true"></i></a></div>
  </div>
</header>
