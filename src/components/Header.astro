---
import { siteConfig } from '../site.config';
import { withBase } from '../lib/content';
import { Logo } from './upstream/Logo';
import { FaSolidDotCircle, IcTwotoneSignpost, FaSolidFeatherAlt, FaSolidHistory } from './upstream/menu-collection';
const pathname = Astro.url.pathname;
const navIcons = [FaSolidDotCircle, IcTwotoneSignpost, FaSolidFeatherAlt, FaSolidHistory];
---
<!-- Shiro Header grid, sizing and ForDesktop capsule styles, without auth providers. -->
<header class="site-header fixed inset-x-0 top-0 z-[9] h-[4.5rem]" data-pagefind-ignore>
  <div class="header-grid relative mx-auto grid h-full max-w-7xl grid-cols-[4.5rem_auto_4.5rem] lg:px-8">
    <div class="header-logo center flex">
      <a href={withBase('/')} aria-label={`${siteConfig.title}首页`}><Logo aria-hidden="true" /></a>
    </div>
    <details class="mobile-menu lg:hidden">
      <summary aria-label="展开导航" class="center flex size-[4.5rem] cursor-pointer"><i class="i-mingcute-menu-line text-xl" aria-hidden="true"></i></summary>
      <nav aria-label="手机导航" class="mobile-menu-panel">
        {siteConfig.nav.map(item => <a href={withBase(item.path)}>{item.title}</a>)}
        <a href={withBase('/search/')}>搜索</a>
      </nav>
    </details>
    <div class="center hidden min-w-0 grow lg:flex">
      <nav aria-label="主导航" class="relative rounded-full bg-gradient-to-b from-zinc-50/70 to-white/90 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur-md dark:from-zinc-900/70 dark:to-zinc-800/90 dark:ring-zinc-100/10">
        <div class="flex px-4 font-medium text-zinc-800 dark:text-zinc-200">
          {siteConfig.nav.map((item,index) => {
            const link = withBase(item.path);
            const active = pathname === link || (item.path !== '/' && pathname.startsWith(link));
            const Icon = navIcons[index];
            return <a href={link} aria-current={active ? 'page' : undefined} class:list={['relative block whitespace-nowrap px-4 py-2 transition duration-200', active ? 'text-accent' : 'hover:text-accent/80']}>
              <span class="relative flex items-center">{active && (Icon ? <Icon className="mr-2" aria-hidden="true" /> : <i class:list={[item.icon, 'mr-2']} aria-hidden="true"></i>)}{item.title}</span>
              {active && <span class="absolute inset-x-1 -bottom-px h-px bg-gradient-to-r from-accent/0 via-accent/70 to-accent/0"></span>}
            </a>;
          })}
        </div>
      </nav>
    </div>
    <div class="center flex"><a href={withBase('/search/')} aria-label="搜索文章" class="center flex size-10 rounded-full transition hover:bg-zinc-100 dark:hover:bg-zinc-800"><i class="i-mingcute-search-line text-xl" aria-hidden="true"></i></a></div>
  </div>
</header>
