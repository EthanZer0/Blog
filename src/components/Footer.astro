---
import ThemeSwitcher from './ThemeSwitcher';
import { siteConfig } from '../site.config';
import { withBase } from '../lib/content';
---
<footer class="site-footer relative z-[1] mt-32 pb-8 pt-14" data-pagefind-ignore>
  <div class="px-4 sm:px-8">
    <div class="relative mx-auto max-w-7xl lg:px-8">
      <div>
        <p class="m-0 font-serif text-[1.375rem] leading-relaxed text-[#615d53] dark:text-[#d4cec1]">{siteConfig.owner}</p>
        <p class="mb-0 mt-1 font-serif text-sm italic leading-relaxed">{siteConfig.hero.description}</p>
      </div>
      <p class="mb-0 mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs leading-relaxed">
        <span>© {new Date().getFullYear()} <a href={withBase('/')} class="link-hover">{siteConfig.owner}</a></span>
        <span aria-hidden="true" class="opacity-50">·</span>
        <span>Powered by <a class="link-hover" href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a> & <a class="link-hover" href="https://github.com/Innei/Shiro" target="_blank" rel="noreferrer">白</a></span>
      </p>
      <div class="mt-8 border-t border-[#9c906e]/15 pt-4 dark:border-[#d4cec1]/10">
        <nav aria-label="页尾导航" class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-2 pr-32 text-sm">
          <a href={withBase('/about/')} class="link-hover">关于我</a>
          <span aria-hidden="true" class="opacity-30">|</span>
          <a href={withBase('/feed.xml')} class="link-hover">RSS</a>
          <span aria-hidden="true" class="opacity-30">|</span>
          <a href={withBase('/sitemap-index.xml')} class="link-hover">站点地图</a>
        </nav>
      </div>
      <div class="absolute bottom-0 right-0 lg:right-8"><ThemeSwitcher client:load /></div>
    </div>
  </div>
</footer>
