---
import ThemeSwitcher from './ThemeSwitcher';
import { siteConfig } from '../site.config';
import { withBase } from '../lib/content';
---
<!-- Shiro Footer.tsx spacing and FooterInfo structure. -->
<footer class="relative z-[1] mt-32 border-t bg-[var(--footer-bg)] py-6 text-base-content/80" data-pagefind-ignore>
  <div class="px-4 sm:px-8"><div class="relative mx-auto max-w-7xl lg:px-8">
    <div class="space-x-0 space-y-3 md:space-x-6 md:space-y-0"><div class="flex items-center gap-4 md:inline-flex"><b class="inline-flex items-center font-medium">更多 <svg class="ml-2 inline -rotate-90 select-none" width="1em" height="1em" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 294.1L383 167c9.4-9.4 24.6-9.4 33.9 0s9.3 24.6 0 34L273 345c-9.1 9.1-23.7 9.3-33.1.7L95 201.1c-4.7-4.7-7-10.9-7-17s2.3-12.3 7-17c9.4-9.4 24.6-9.4 33.9 0l127.1 127z" /></svg></b><span class="space-x-4 text-neutral-8/90"><a href={withBase('/about/')} class="link-hover link">关于</a><a href={withBase('/timeline/')} class="link-hover link">时光</a></span></div></div>
    <div class="mt-12 space-y-3 text-center md:mt-6 md:text-left">
      <div><span>© {new Date().getFullYear()} </span><a href={withBase('/')}>{siteConfig.owner}</a><span>.</span><span class="select-none whitespace-pre opacity-50"> | </span><a href={withBase('/feed.xml')}>RSS</a><span class="select-none whitespace-pre opacity-50"> | </span><a href={withBase('/sitemap-index.xml')}>站点地图</a><span class="select-none whitespace-pre opacity-50"> | </span><span class="mt-3 block md:mt-0 md:inline">Stay hungry. Stay foolish.</span></div>
      <div><span class="my-3 block md:my-0 md:inline">Powered by <a class="link-hover link" href="https://astro.build/">Astro</a><span class="mx-1">&</span><a class="link-hover link" href="https://github.com/Innei/Shiro">白</a>.</span></div>
    </div>
    <div class="mt-6 flex flex-col items-center gap-4 md:absolute md:bottom-0 md:right-0 md:mt-0 md:flex-row"><ThemeSwitcher client:load /></div>
  </div></div>
</footer>
