---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
const rootDepth = Math.min(...headings.map(heading => heading.depth));
---
<nav class="absolute flex h-full min-h-[120px] flex-col" aria-label="文章目录" data-toc data-pagefind-ignore>
  <ul class="toc-list min-h-0 grow text-sm">{headings.map(heading => <li style={`padding-left:${Math.max(0,heading.depth-rootDepth)*.6}rem`}><a title={heading.text} href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
  <div class="mt-4 border-t pt-4 text-zinc-800 dark:text-neutral-300">
    <div class="flex items-center gap-2" role="progressbar" data-reading-progress aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <svg width="14" height="14" viewBox="0 0 14 14" class="-rotate-90" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-opacity=".15" stroke-width="2" /><circle data-progress-ring cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="2" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" /></svg><span data-progress-label>0%</span>
    </div>
    <a href="#main" data-back-to-top class="mt-1 flex items-center gap-2 opacity-0 transition-all duration-500 hover:opacity-100" tabindex="-1"><i class="i-mingcute-arrow-up-circle-line" aria-hidden="true"></i><span class="whitespace-nowrap">回到顶部</span></a>
  </div>
</nav>
