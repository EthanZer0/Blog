---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero';
import { articles, articlePath, formatDate, withBase } from '../lib/content';
const posts = await articles('posts');
const notes = await articles('notes');
const entries = [...posts, ...notes].sort((a,b) => b.data.published.getTime() - a.data.published.getTime());
const today = new Date();
const months = Array.from({ length: 12 }, (_, i) => {
  const date = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() - 11 + i, 1));
  return { label: `${date.getUTCFullYear()}.${date.getUTCMonth()+1}`, entries: entries.filter(entry => entry.data.published.getUTCFullYear() === date.getUTCFullYear() && entry.data.published.getUTCMonth() === date.getUTCMonth()) };
});
---
<Base>
  <main id="main" class="min-w-0">
    <Hero client:load />
    <!-- Original ActivityScreen / TwoColumnLayout proportions; activities now build from public files. -->
    <section id="recent" class="mx-auto mt-24 max-w-[1800px] scroll-mt-24" data-pagefind-ignore>
      <div class="relative mx-auto block w-full min-w-0 lg:flex">
        <div class="center flex w-full flex-col px-4 lg:w-1/2"><div class="w-full max-w-2xl">
          <section class="mt-8 flex flex-col gap-4 lg:mt-0">
            <h2 class="text-2xl font-medium leading-loose">最近文稿</h2>
            <ul class="shiro-timeline mt-4">{posts.slice(0,5).map(entry => <li class="flex min-w-0 justify-between"><a class="min-w-0 truncate" href={withBase(articlePath(entry))}>{entry.data.title}</a><time class="ml-2 shrink-0 self-end text-xs opacity-70" datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time></li>)}</ul>
            <a class="flex items-center justify-end opacity-70 duration-200 hover:text-accent" href={withBase('/posts/')}><i class="i-mingcute-arrow-right-circle-line" aria-hidden="true"></i><span class="ml-2">更多文稿</span></a>
            <hr class="my-6 opacity-30" />
            <h2 class="text-2xl font-medium leading-loose">最近手记</h2>
            <ul class="shiro-timeline mt-4">{notes.slice(0,5).map(entry => <li class="flex min-w-0 justify-between"><a class="min-w-0 truncate" href={withBase(articlePath(entry))}>{entry.data.title}</a><time class="ml-2 shrink-0 self-end text-xs opacity-70" datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time></li>)}</ul>
            <a class="flex items-center justify-end opacity-70 duration-200 hover:text-accent" href={withBase('/notes/')}><i class="i-mingcute-arrow-right-circle-line" aria-hidden="true"></i><span class="ml-2">更多手记</span></a>
          </section>
        </div></div>
        <div class="mt-8 block w-full px-4 text-lg lg:mt-0 lg:flex lg:w-1/2 lg:justify-center"><div class="w-full max-w-2xl">
          <h2 class="mb-8 text-2xl font-medium leading-loose lg:ml-8">最近动态</h2>
          <div class="relative max-h-[80vh] min-h-[200px] overflow-y-auto lg:h-[400px]">
            <ul class="shiro-timeline mt-4 flex flex-col pb-8 pl-2">{entries.slice(0,8).map(entry => <li class="flex min-w-0 justify-between pb-5!">
              <div class="flex flex-col gap-2"><div class="flex translate-y-1/4 items-center gap-2"><span class="center inline-flex size-6 shrink-0 rounded-full border border-accent/30 text-xs text-accent"><i class={entry.collection === 'posts' ? 'i-mingcute-book-2-line' : 'i-mingcute-quill-pen-line'} aria-hidden="true"></i></span><small>发布了{entry.collection === 'posts' ? '文稿' : '手记'}</small><a href={withBase(articlePath(entry))}><b>{entry.data.title}</b></a></div><time class="pl-8 text-xs opacity-50" datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time></div>
            </li>)}</ul>
          </div>
        </div></div>
      </div>
    </section>
    <section class="mt-24 w-full" data-pagefind-ignore>
      <h2 class="my-5 text-center text-2xl font-medium">文字留下的足迹</h2>
      <div class="year-chart my-12"><div class="year-chart-inner mx-auto max-w-[1800px]"><div class="year-chart-line">{months.map(month => <div class="year-chart-month"><span>{month.label}</span>{month.entries.map((entry,i) => <a href={withBase(articlePath(entry))} title={`${formatDate(entry.data.published)} · ${entry.data.title}`} aria-label={entry.data.title} style={`left:${entry.data.published.getUTCDate()/32*90}%;height:${24+(i%4)*14}px`}></a>)}</div>)}</div></div></div>
    </section>
  </main>
</Base>
