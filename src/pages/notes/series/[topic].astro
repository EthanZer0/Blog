---
import Base from '../../../layouts/Base.astro';
import {articles,articlePath,withBase} from '../../../lib/content';
export async function getStaticPaths(){const notes=await articles('notes');return [...new Set(notes.map(note=>note.data.topic).filter(Boolean))].map(topic=>({params:{topic},props:{topic,notes:notes.filter(note=>note.data.topic===topic)}}));}
const {topic,notes}=Astro.props;
---
<Base title={topic}><main id="main" data-header-hide-bg class="mx-auto mt-14 max-w-3xl px-2 lg:mt-[80px] lg:px-0 2xl:max-w-4xl"><header class="prose mb-[80px]"><h1>{topic}</h1></header><ul class="shiro-timeline">{notes.map(note=><li><a href={withBase(articlePath(note))}>{note.data.title}</a></li>)}</ul></main></Base>
