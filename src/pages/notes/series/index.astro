---
import {EmptyIcon} from '../../../components/upstream/empty';
import Base from '../../../layouts/Base.astro';
import {articles,withBase} from '../../../lib/content';
const notes=await articles('notes');
const topics=[...new Set(notes.map(note=>note.data.topic).filter(Boolean))];
---
<Base title="专栏"><main id="main" data-header-hide-bg class="mx-auto mt-14 max-w-3xl px-2 lg:mt-[80px] lg:px-0 2xl:max-w-4xl"><header class="prose mb-[80px]"><h1>专栏</h1></header><ul class="shiro-timeline">{topics.map(topic=><li><a href={withBase(`/notes/series/${encodeURIComponent(topic!)}/`)}>{topic}</a></li>)}</ul>{!topics.length&&<div class="center my-12 flex flex-col gap-4"><EmptyIcon/><span class="opacity-60">暂无专栏</span></div>}</main></Base>
