---
import { render } from 'astro:content';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import TocDialog from '../components/TocDialog';
import { MdiClockOutline, MdiClockTimeThreeOutline } from '../components/upstream/clock';
import { FeHash } from '../components/upstream/fa-hash';
import { articles, articlePath, formatDate, tagPath, withBase, type Entry } from '../lib/content';
import { siteConfig } from '../site.config';
interface Props { entry: Entry; }
const { entry } = Astro.props;
const { Content, headings: allHeadings } = await render(entry);
const headings = allHeadings.filter(heading => heading.slug !== 'footnote-label');
const all = await articles(entry.collection);
const index = all.findIndex(item => item.id === entry.id);
const previous = all[index + 1];
const next = all[index - 1];
const note = entry.collection === 'notes';
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: entry.data.title, description: entry.data.description, datePublished: entry.data.published.toISOString(), dateModified: (entry.data.updated || entry.data.published).toISOString(), author: { '@type': 'Person', name: siteConfig.owner }, url: new URL(withBase(articlePath(entry)), Astro.site).href };
---
<Base title={entry.data.title} description={entry.data.description} article>
  <div id="main" class:list={[note ? 'note-layout relative mx-auto mt-12 grid min-h-[calc(100vh-6.5rem-10rem)] max-w-[60rem] gap-4 md:mt-24 md:grid-cols-1 xl:max-w-[calc(60rem+400px)] xl:grid-cols-[1fr_minmax(auto,60rem)_1fr]' : 'container mx-auto mt-[120px] max-w-7xl px-2 md:px-6 lg:px-4 xl:px-0']}>
    {note && <aside class="hidden min-w-0 xl:block" data-pagefind-ignore><nav aria-label="手记时间线" class="sticky top-[120px] mt-[120px] min-h-[300px]"><ul class="space-y-1 [&_i]:hover:text-accent">{all.slice(0,10).map(item => <li class="flex items-center">{item.id === entry.id && <span class="inline-flex items-center"><i class="i-material-symbols-arrow-circle-right-outline-rounded duration-200" /></span>}<a href={withBase(articlePath(item))} class:list={['min-w-0 truncate text-left text-neutral tabular-nums transition-all hover:opacity-80',item.id === entry.id ? 'ml-2 opacity-100' : 'opacity-50']}>{item.data.title}</a></li>)}</ul></nav></aside>}
    <div class:list={['reading-layout relative min-h-[120px]', note && 'reading-layout--note']}>
      <main class:list={['relative min-w-0', !note && 'w-full', note && 'note-paper -m-4 rounded-[0_6px_6px_0] border-zinc-200/70 bg-white p-[2rem_1rem] shadow-perfect perfect-sm md:m-0 lg:border lg:p-[30px_45px] dark:border-neutral-800 dark:bg-zinc-900']}>
        <div data-reading-region>
        <div class:list={[!note && 'mb-8']}>
          <h1 class:list={['text-4xl font-bold leading-tight text-balance', note ? 'my-8 text-left text-base-content/95' : 'mb-8 text-center']} data-pagefind-meta="title">{entry.data.title}</h1>
          <div class:list={['flex flex-wrap items-center gap-2 text-sm', note ? 'text-neutral/60' : 'mb-8 justify-center text-neutral']} data-pagefind-ignore>
            <span class="flex items-center gap-1"><MdiClockOutline aria-hidden="true" /><time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time></span>
            <span class="flex items-center gap-1"><FeHash aria-hidden="true" /><a href={withBase(`/categories/${entry.data.categorySlug}/`)}>{entry.data.category}</a>{entry.data.tags.length > 0 && <span>/ {entry.data.tags.map((tag,i) => <><a href={withBase(tagPath(tag))} class="shiro-link--underline">{tag}</a>{i < entry.data.tags.length-1 ? ', ' : ''}</>)}</span>}</span>
          </div>
        </div>
        {headings.length > 0 && <TocDialog headings={headings} client:load />}
        <article class:list={['prose markdown', note && 'markdown--note']} data-article-body data-pagefind-body>
          <Content />
        </article>
        </div>
        {!note && <section id="copyright" class="mt-4 text-sm leading-loose text-zinc-600 dark:text-neutral-400" data-pagefind-ignore>
          <p>文章标题：{entry.data.title}</p><p>文章作者：{siteConfig.owner}</p>
          <p>文章链接：<a href={withBase(articlePath(entry))}>{ld.url}</a></p>
          <p>最后修改：{entry.data.updated ? formatDate(entry.data.updated) : '暂无修改'}</p>
          <hr class="my-4 h-[0.5px] border-0 bg-black/30 dark:bg-white/30" />
          <p>转载请注明作者与文章出处。</p>
        </section>}
        {note && (previous || next) && <nav aria-label="前后篇文章" class="article-navigation relative mt-4 py-2 text-center" data-pagefind-ignore>
          <div class="flex items-center justify-between [&>*]:inline-flex [&>*]:items-center [&>*]:space-x-2 [&>*]:p-2">
            <span>{previous && <a href={withBase(articlePath(previous))} class="inline-flex items-center space-x-2 hover:text-accent"><i class="i-mingcute-arrow-left-line" /><span>前一篇</span></a>}</span>
            <span>{next && <a href={withBase(articlePath(next))} class="inline-flex items-center space-x-2 hover:text-accent"><span>后一篇</span><i class="i-mingcute-arrow-right-line" /></a>}</span>
          </div>
          <a href={`${withBase('/timeline/')}?type=note&selectId=${encodeURIComponent(entry.id)}`} class="absolute inset-y-0 left-1/2 flex -translate-x-1/2 items-center space-x-2 text-accent opacity-80 hover:text-accent"><span>时间线</span><MdiClockTimeThreeOutline /></a>
        </nav>}
      </main>
      {!note && <aside class="reading-aside relative" data-pagefind-ignore><div class="sticky top-[120px] mt-[120px] ml-4 h-[calc(100vh-6rem-4.5rem-150px-120px)]"><Toc headings={headings} /></div></aside>}
    </div>
    {note && <aside class="relative hidden xl:block" data-pagefind-ignore><div class="sticky top-[120px] mt-[120px] ml-4 h-[calc(100vh-6rem-4.5rem-150px-120px)]"><Toc headings={headings} /></div></aside>}
  </div>
  <div class="fixed inset-y-0 right-px z-[99] w-px transition-opacity duration-200 ease-in-out lg:hidden" data-reading-vertical aria-hidden="true"><div class="absolute top-0 w-full bg-accent/80 duration-75 ease-linear" data-progress-vertical /></div>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
</Base>
