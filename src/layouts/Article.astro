---
import 'katex/dist/katex.min.css';
import EditedTime from '../components/EditedTime';
import {slugify} from '../lib/heading-slug';
import { render } from 'astro:content';
import {NoteBottomTopic} from '../components/NoteBottomTopic';
import PostCopyright from '../components/PostCopyright';
import NoteMetadata from '../components/NoteMetadata';
import NoteHeaderDate from '../components/NoteHeaderDate';
import PostOutdate from '../components/PostOutdate';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import TocDialog from '../components/TocDialog';
import ArticleShare from '../components/ArticleShare';
import { MdiClockOutline, MdiClockTimeThreeOutline } from '../components/upstream/clock';
import { FeHash } from '../components/upstream/fa-hash';
import { articles, articlePath, formatDate, tagPath, withBase, type Entry } from '../lib/content';
import { siteConfig } from '../site.config';
import { relatedTargets } from '../lib/related';
interface Props { entry: Entry; preview?: boolean; }
const { entry, preview = false } = Astro.props;
const { Content, headings: allHeadings } = await render(entry);
const headings = allHeadings.filter(heading => heading.slug !== 'footnote-label').map((heading,index)=>({...heading,slug:`${index}__${slugify(heading.text)}`}));
const all = await articles(entry.collection);
const index = all.findIndex(item => item.id === entry.id);
const previous = index >= 0 ? all[index + 1] : undefined;
const next = index >= 0 ? all[index - 1] : undefined;
const related = relatedTargets(entry.data.related, [...all, ...await articles(entry.collection === 'posts' ? 'notes' : 'posts')]);
const topic=entry.data.topic&&(siteConfig.topics.find(topic=>topic.slug===entry.data.topic)||{slug:entry.data.topic,name:entry.data.topic,introduce:''});
const topicNotes=all.filter(item=>item.data.topic===entry.data.topic).map(item=>({title:item.data.title,url:withBase(articlePath(item)),created:item.data.published.toISOString(),modified:item.data.updated?.toISOString()}));
const note = entry.collection === 'notes';
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: entry.data.title, description: entry.data.description, datePublished: entry.data.published.toISOString(), dateModified: (entry.data.updated || entry.data.published).toISOString(), author: { '@type': 'Person', name: siteConfig.owner }, url: new URL(withBase(articlePath(entry)), Astro.site).href };
---
<Base title={entry.data.title} description={entry.data.description} article noindex={preview}>
  {preview && <div class="mx-auto mt-6 max-w-3xl rounded-xl border border-base-content/10 bg-base-100/80 px-4 py-3 text-sm text-base-content/70 backdrop-blur" data-pagefind-ignore role="status">本地预览 · {entry.data.draft ? '草稿尚未发布' : '已公开文章'} · 保存 Markdown 后自动更新</div>}
  <div id="main" class:list={[note ? 'note-layout relative mx-auto mt-12 grid min-h-[calc(100vh-6.5rem-10rem)] max-w-[60rem] print:block! print:max-w-full! gap-4 md:mt-24 md:grid-cols-1 xl:max-w-[calc(60rem+400px)] xl:grid-cols-[1fr_minmax(auto,60rem)_1fr]' : 'container mx-auto mt-[120px] max-w-7xl px-2 md:px-6 lg:px-4 xl:px-0']}>
    {note && <aside class="hidden min-w-0 xl:block" data-hide-print data-pagefind-ignore><nav aria-label="手记时间线" class="sticky top-[120px] mt-[120px] min-h-[300px]"><ul class="space-y-1 [&_i]:hover:text-accent">{all.slice(0,10).map(item => <li class="flex items-center">{item.id === entry.id && <span class="inline-flex items-center"><i class="i-material-symbols-arrow-circle-right-outline-rounded duration-200" /></span>}<a href={withBase(articlePath(item))} class:list={['min-w-0 truncate text-left text-neutral-8 tabular-nums transition-all hover:opacity-80',item.id === entry.id ? 'ml-2 opacity-100' : 'opacity-50']}>{item.data.title}</a></li>)}</ul></nav></aside>}
    <div class:list={['reading-layout relative min-h-[120px]', note && 'reading-layout--note']}>
      <main class:list={['relative min-w-0', !note && 'w-full', note && 'note-paper -m-4 rounded-[0_6px_6px_0] border-zinc-200/70 bg-white p-[2rem_1rem] shadow-perfect perfect-sm md:m-0 lg:border lg:p-[30px_45px] dark:border-neutral-800 dark:bg-zinc-900 print:border-none! print:bg-transparent! print:shadow-none!']}>

        <div class:list={[!note && 'mb-8']}>
          <h1 class:list={['text-4xl font-bold leading-tight text-balance', note ? 'my-8 text-left text-base-content/95' : 'mb-8 text-center']} data-pagefind-meta="title">{entry.data.title}</h1>
          <div class:list={['flex flex-wrap items-center text-sm', note ? 'text-neutral-8/60' : 'min-w-0 shrink grow gap-2 mb-8 justify-center text-neutral-8']} data-pagefind-ignore>
            <span class="flex min-w-0 items-center space-x-1">{note ? <NoteHeaderDate date={entry.data.published.toISOString()} modified={entry.data.updated?.toISOString()} client:load /> : <><MdiClockOutline aria-hidden="true" /><time datetime={entry.data.published.toISOString()} data-relative-time>{formatDate(entry.data.published)}</time>{entry.data.updated&&<EditedTime date={entry.data.updated.toISOString()} client:load />}</>}</span>
            {!note && <span class="flex items-center gap-1"><FeHash className="translate-y-[0.5px]" aria-hidden="true" /><span>{entry.data.category}</span>{entry.data.tags.length > 0 && <span>/ {entry.data.tags.map((tag,i) => <><a data-tag={tag} href={withBase(tagPath(tag))} class="shiro-link--underline">{tag}</a>{i < entry.data.tags.length-1 ? ', ' : ''}</>)}</span>}</span>}
            {note && <NoteMetadata mood={entry.data.mood} weather={entry.data.weather} />}
          </div>
          {!note && entry.data.updated && <PostOutdate modified={entry.data.updated.toISOString()} client:load />}
        </div>
        {(note || headings.length > 0) && <TocDialog headings={headings} note={note} client:load />}
        <article class:list={['prose markdown', note && 'markdown--note']} data-article-body data-reading-region data-focus-reading={!note ? true : undefined} data-image-records={JSON.stringify(entry.data.images.map(image=>({...image,src:withBase(image.src)})))} data-pagefind-body>
          <span hidden data-pagefind-meta="subtitle">{note?'手记':entry.data.category}</span>
          <Content />
        </article>
        <div data-article-end aria-hidden="true"></div>

        {!note && related.length>0 && <div data-hide-print class="prose mb-5 mt-8"><h3 class="flex items-center gap-2 text-lg font-medium"><i class="i-mingcute-question-line"/><span>关联阅读</span></h3><ul class="ml-0 mt-4 list-inside list-disc pl-0 text-base leading-relaxed">{related.map(item=><li><a class="shiro-link--underline" href={withBase(articlePath(item))}>{item.data.title}</a></li>)}</ul></div>}
        {!note && <PostCopyright title={entry.data.title} name={siteConfig.owner} link={ld.url} published={entry.data.published.toISOString()} updated={entry.data.updated?.toISOString()} license={entry.data.license} client:load />}
        {note && topic && <NoteBottomTopic topic={topic} notes={topicNotes} client:load />}
        <ArticleShare title={entry.data.title} text={entry.body || entry.data.description} path={withBase(articlePath(entry))} note={note} client:load />
        {note && (previous || next) && <nav aria-label="前后篇文章" class="article-navigation relative mt-4 py-2 text-center" data-pagefind-ignore>
          <div class="flex items-center justify-between [&>*]:inline-flex [&>*]:items-center [&>*]:space-x-2 [&>*]:p-2">
            <span>{previous && <a href={withBase(articlePath(previous))} class="inline-flex items-center space-x-2 hover:text-accent"><i class="i-mingcute-arrow-left-line" /><span>前一篇</span></a>}</span>
            <span>{next && <a href={withBase(articlePath(next))} class="inline-flex items-center space-x-2 hover:text-accent"><span>后一篇</span><i class="i-mingcute-arrow-right-line" /></a>}</span>
          </div>
          <a href={`${withBase('/timeline/')}?type=note&selectId=${encodeURIComponent(entry.id)}`} class="absolute inset-y-0 left-1/2 flex -translate-x-1/2 items-center space-x-2 text-accent opacity-80 hover:text-accent"><span>时间线</span><MdiClockTimeThreeOutline /></a>
        </nav>}
      </main>
      {!note && <aside class="reading-aside relative" data-pagefind-ignore><div class="sticky top-[120px] mt-[120px] ml-4 h-[calc(100vh-6rem-4.5rem-150px-120px)]"><Toc headings={headings} /><ArticleShare title={entry.data.title} text={entry.body || entry.data.description} path={withBase(articlePath(entry))} note={note} aside client:load /></div></aside>}
    </div>
    {note && <aside class="relative hidden xl:block" data-hide-print data-pagefind-ignore><div class="sticky top-[120px] mt-[120px] ml-4 h-[calc(100vh-6rem-4.5rem-150px-120px)]"><Toc headings={headings} /><ArticleShare title={entry.data.title} text={entry.body || entry.data.description} path={withBase(articlePath(entry))} note={note} aside client:load /></div></aside>}
  </div>
  <div class="fixed inset-y-0 right-px z-[99] w-px transition-opacity duration-200 ease-in-out" data-reading-vertical data-hide-print aria-hidden="true"><div class="absolute top-0 w-full bg-accent/80 duration-75 ease-linear" data-progress-vertical /></div>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
</Base>
